# Conduit configuration. Copy to `.env` and fill in. `.env` is git-ignored.
# All variables use the CONDUIT_ prefix and are read via pydantic-settings.
#
# The URLs below target localhost for local `make dev`. docker-compose overrides
# CONDUIT_DATABASE_URL / CONDUIT_REDIS_URL with in-network service names.

# --- Runtime ---
CONDUIT_ENV=development          # development | production
CONDUIT_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
CONDUIT_HOST=0.0.0.0
CONDUIT_PORT=8080
CONDUIT_WORKERS=2                # gunicorn workers (prod)

# --- Datastores ---
CONDUIT_DATABASE_URL=postgresql+asyncpg://conduit:conduit@localhost:5432/conduit
CONDUIT_REDIS_URL=redis://localhost:6379/0

# --- Admin / bootstrap ---
# Guards the admin endpoints and the `conduit keys create` CLI. Generate a long
# random value. Do NOT reuse across environments.
CONDUIT_ADMIN_API_KEY=change-me-generate-a-long-random-secret

# --- Providers ---
# OpenAI upstream credentials (never logged, never stored in the DB in plaintext).
CONDUIT_OPENAI_API_KEY=sk-your-openai-key
CONDUIT_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama runs locally by default.
CONDUIT_OLLAMA_BASE_URL=http://localhost:11434

# --- Observability (V4; only used with the compose `observability` profile) ---
CONDUIT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CONDUIT_OTEL_SERVICE_NAME=conduit
CONDUIT_METRICS_ENABLED=true
